{
 "datasets": [
  {
   "name": "ds0",
   "displayName": "Releases",
   "queryLines": [
    "SELECT key, get_json_object(payload, '$.verdict') AS verdict, get_json_object(payload, '$.candidate') AS candidate, get_json_object(payload, '$.reasons') AS reasons, get_json_object(payload, '$.warnings') AS warnings, ts FROM release.decisions ORDER BY ts DESC LIMIT 200"
   ]
  },
  {
   "name": "ds1",
   "displayName": "Red team",
   "queryLines": [
    "SELECT key AS run_day, get_json_object(payload, '$.overall_asr.mean') AS asr, get_json_object(payload, '$.overall_asr.n_items') AS n, get_json_object(payload, '$.truncated') AS truncated, get_json_object(payload, '$.cost_usd') AS cost_usd FROM redteam.runs ORDER BY key DESC LIMIT 200"
   ]
  },
  {
   "name": "ds2",
   "displayName": "Improvement",
   "queryLines": [
    "SELECT key AS cycle_day, get_json_object(payload, '$.node') AS node, get_json_object(payload, '$.mode') AS mode, get_json_object(payload, '$.accepted') AS accepted, get_json_object(payload, '$.iterations') AS iterations, get_json_object(payload, '$.truncated') AS truncated FROM improve.cycles ORDER BY key DESC LIMIT 200"
   ]
  },
  {
   "name": "ds3",
   "displayName": "Judges",
   "queryLines": [
    "SELECT key AS day, get_json_object(payload, '$.metric') AS metric, get_json_object(payload, '$.judge') AS judge, get_json_object(payload, '$.kappa') AS kappa, get_json_object(payload, '$.n_labels') AS n_labels, get_json_object(payload, '$.status') AS status FROM judging.trust ORDER BY key DESC LIMIT 200"
   ]
  },
  {
   "name": "ds4",
   "displayName": "Runtime",
   "queryLines": [
    "SELECT key AS day, get_json_object(payload, '$.n') AS n, get_json_object(payload, '$.error_rate') AS error_rate, get_json_object(payload, '$.decision_line_rate') AS decision_line_rate, get_json_object(payload, '$.pii_leak_count') AS pii_leak_count, get_json_object(payload, '$.latency_p95_s') AS latency_p95_s FROM monitoring.daily_quality ORDER BY key DESC LIMIT 200"
   ]
  },
  {
   "name": "ds5",
   "displayName": "Incidents and breaker",
   "queryLines": [
    "SELECT key, get_json_object(payload, '$.agent') AS agent, get_json_object(payload, '$.mode') AS mode, get_json_object(payload, '$.reason') AS reason, get_json_object(payload, '$.set_by') AS set_by, get_json_object(payload, '$.expires_at') AS expires_at FROM state.runtime_flags  LIMIT 200"
   ]
  }
 ],
